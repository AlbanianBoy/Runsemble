# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/runsemble

# ── Auth (cookie-based — no JWT secret required) ──────────────────────────────
# SESSION_DAYS=30   # optional, defaults to 30

# ── Email (verification codes + password reset) ───────────────────────────────
EMAIL_FROM=noreply@runsemble.app
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
