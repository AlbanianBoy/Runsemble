# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/runsemble

# ── Auth (cookie-based — no JWT secret required) ──────────────────────────────
# SESSION_DAYS=30   # optional, defaults to 30

# ── Email (verification codes + password reset) ───────────────────────────────
EMAIL_FROM=noreply@runsemble.app
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# ── Post image storage (optional) ─────────────────────────────────────────────
# Set by Vercel automatically once a Blob store is connected to the project.
# When either is present, post photos go to Blob and only the URL is stored;
# when neither is, they fall back to inline base64 in Postgres (fine for local
# dev, but it grows the database — connect a store before real traffic).
#
# Connecting a store sets BLOB_STORE_ID and authenticates over OIDC: Vercel
# injects a short-lived VERCEL_OIDC_TOKEN at runtime and there is NO static
# token. BLOB_READ_WRITE_TOKEN is the older style and is still supported.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# ── Product analytics (optional) ──────────────────────────────────────────────
# PostHog. Without the key the SDK never initialises — no network, no cost, every
# track() call is a no-op. Add the key to light it up. Use the EU host so location
# data stays in-region (GDPR). Create a project at eu.posthog.com → Project API key.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Error tracking (optional) ─────────────────────────────────────────────────
# Sentry. Without the DSN, Sentry is inert (no reporting, build unaffected). Add
# the DSN to start capturing production errors. sentry.io → project → DSN.
# NEXT_PUBLIC_SENTRY_DSN=https://...ingest.sentry.io/...

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
