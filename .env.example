# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/runsemble

# ── Auth (cookie-based — no JWT secret required) ──────────────────────────────
# SESSION_DAYS=30   # optional, defaults to 30

# ── Email (verification codes + password reset) ───────────────────────────────
# Sent via Resend, not SMTP. Without the key, emails are skipped and the code is
# logged in dev instead — signup still works.
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@runsemble.net

# ── Admin / operations ────────────────────────────────────────────────────────
# Comma-separated emails allowed into /admin (the report queue + suspend action).
ADMIN_EMAILS=you@example.com
# Shared secret for the Vercel Cron jobs. Vercel sends it as
# `Authorization: Bearer <CRON_SECRET>`; without it the cron endpoints refuse
# every request, so the GPS-retention job stays inert until this is set.
CRON_SECRET=

# ── Post image storage (optional) ─────────────────────────────────────────────
# Set by Vercel automatically once a Blob store is connected to the project.
# When either is present, post photos go to Blob and only the URL is stored;
# when neither is, they fall back to inline base64 in Postgres (fine for local
# dev, but it grows the database — connect a store before real traffic).
#
# Connecting a store sets BLOB_STORE_ID and authenticates over OIDC: Vercel
# injects a short-lived VERCEL_OIDC_TOKEN at runtime and there is NO static
# token. BLOB_READ_WRITE_TOKEN is the older style and is still supported.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# ── Product analytics (optional) ──────────────────────────────────────────────
# PostHog. Without the key the SDK never initialises — no network, no cost, every
# track() call is a no-op. Add the key to light it up. Use the EU host so location
# data stays in-region (GDPR). Create a project at eu.posthog.com → Project API key.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Error tracking (optional) ─────────────────────────────────────────────────
# Sentry. Without the DSN, Sentry is inert (no reporting, build unaffected). Add
# the DSN to start capturing production errors. sentry.io → project → DSN.
# NEXT_PUBLIC_SENTRY_DSN=https://...ingest.sentry.io/...

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Secret behind the per-user map location grid (src/lib/location-privacy.ts).
# Every runner's ~200m privacy cell is offset by an amount derived from this, so
# the grid lines aren't public knowledge and two people in one place don't
# publish identical coordinates. Any long random string; generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it the offset falls back to being derived from the user id alone,
# which is still better than one shared grid but is recomputable by anyone.
# Changing it moves every published pin — harmless, but do it deliberately.
LOCATION_SALT=

# ── Capacitor native build ─────────────────────────────────────────────────────
# Override the server URL the native shell loads. Defaults to https://runsemble.net.
# Set this before running `npx cap sync` to point a dev or staging native build
# at a different origin — e.g. CAP_SERVER_URL=https://staging.runsemble.net
# Never set this in Vercel env vars; it is only read at `cap sync` time on your machine.
# CAP_SERVER_URL=https://runsemble.net
