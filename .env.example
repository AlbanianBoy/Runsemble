# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/runsemble

# ── Auth (cookie-based — no JWT secret required) ──────────────────────────────
# SESSION_DAYS=30   # optional, defaults to 30

# ── Email (verification codes + password reset) ───────────────────────────────
EMAIL_FROM=noreply@runsemble.app
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# ── Post image storage (optional) ─────────────────────────────────────────────
# Set by Vercel automatically once a Blob store is linked to the project.
# When present, post photos are uploaded to Blob and only the URL is stored.
# When absent, photos fall back to inline base64 in Postgres (fine for local dev,
# but it grows the database — link a store before real traffic).
# BLOB_READ_WRITE_TOKEN=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
