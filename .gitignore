# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Android signing keys — NEVER commit these. Losing/leaking them compromises releases.
*.jks
*.keystore

# Firebase — contains project credentials, never commit
android/app/google-services.json

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# local sqlite dev database (regenerate with: npx prisma db push && node seed-db.ts)
prisma/dev.db
prisma/dev.db-journal.env

.env.local

# Scan / audit output artifacts — generated locally, not part of source
repomix-output.xml
runsemble-audit.xml
runsemble-tracking-audit.xml

# Scratch / temp files
phase2-recorder-code.txt
mcps/
native/
