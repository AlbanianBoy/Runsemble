generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  avatar            String?
  bio               String?
  city              String    @default("Antwerp")
  lat               Float?
  lng               Float?
  gender            String?   // optional, unlocks women-only runs
  verified          Boolean   @default(false)
  passwordHash      String?   // scrypt salt:hash; null for seed/demo profiles
  consentAt         DateTime? // when the user accepted data processing (GDPR)
  emailVerified     Boolean   @default(false) // confirmed via 6-digit code
  emailVerifiedAt   DateTime?
  preferredSport    String    @default("running")
  paceLevel         String    @default("beginner") // beginner, intermediate, advanced, any
  schedulePreference String   @default("evening") // morning, afternoon, evening
  xp                Int       @default(0)
  streak            Int       @default(0)
  longestStreak     Int       @default(0)
  lastActiveDate    String?
  totalRuns         Int       @default(0)
  totalPeopleRunWith Int      @default(0)
  totalDistanceKm   Float     @default(0)
  totalDurationSec  Int       @default(0)
  isAvailable       Boolean   @default(false)
  availableFrom     DateTime? // planned availability ("free to run at 18:30")
  availableUntil    DateTime?
  privacyVisible    Boolean   @default(true)
  onboardingComplete Boolean  @default(false)
  fcmToken          String?   // FCM device token for push notifications
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  posts             FeedPost[]
  joinedHotspots    HotspotParticipant[]
  groupMemberships  GroupMember[]
  sentMessages      ChatMessage[] @relation("SentMessages")
  receivedMessages  ChatMessage[] @relation("ReceivedMessages")
  sentInvites       RunInvite[] @relation("SentInvites")
  receivedInvites   RunInvite[] @relation("ReceivedInvites")
  earnedBadges      UserBadge[]
  runRatings        RunRating[]
  postLikes         PostLike[]
  postComments      PostComment[]
  runSessions       RunSession[]
  notifications     Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")
  buddies           Buddy[] @relation("BuddyOwner")
  buddyOf           Buddy[] @relation("BuddyTarget")
  blocksMade        Block[] @relation("Blocker")
  blockedBy         Block[] @relation("Blocked")
  challengesJoined  ChallengeParticipant[]
  sessions          Session[]
  verificationTokens VerificationToken[]

  // The leaderboard sorts by any of these; each needs its own index or the board
  // degrades to a full scan + sort. xp is the default board, the rest are one tap away.
  @@index([xp])
  @@index([streak])
  @@index([totalRuns])
  @@index([totalDistanceKm])
  @@index([totalPeopleRunWith])
}

// Login sessions — token lives in an httpOnly cookie.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Short-lived 6-digit codes for email verification and password reset.
// Stored as a SHA-256 hash; single-use (consumedAt) with an attempt cap.
model VerificationToken {
  id         String    @id @default(cuid())
  userId     String
  type       String    // "email_verify" | "password_reset"
  codeHash   String    // sha256 hex of the 6-digit code
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Hotspot {
  id          String    @id @default(cuid())
  name        String
  description String?
  location    String
  lat         Float
  lng         Float
  sportType   String    @default("running")
  distanceKm  Float     @default(5.0)
  paceRange   String    @default("any")
  startTime   DateTime
  recurringIntervalMin Int @default(30)
  daysOfWeek  String?   // for weekly official runs, e.g. "1,3,5" (Mon/Wed/Fri); null = continuous
  audience    String    @default("all") // all, women, beginner
  lobbyStartedAt DateTime? // set when someone taps "Start together" in the lobby
  isActive    Boolean   @default(true)
  isOfficial  Boolean   @default(false) // curated city spot vs. user-created
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  participants HotspotParticipant[]
  ratings     RunRating[]
  runSessions RunSession[]
}

model HotspotParticipant {
  id          String   @id @default(cuid())
  hotspotId   String
  userId      String
  joinedAt    DateTime @default(now())
  status      String   @default("joined") // joined, here (checked in at lobby), completed, cancelled
  checkedInAt DateTime?

  hotspot     Hotspot  @relation(fields: [hotspotId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hotspotId, userId])
}

model RunGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  isPublic    Boolean  @default(true)
  coverImage  String?
  city        String   @default("Antwerp")
  memberCount Int      @default(0)
  lobbyStartedAt DateTime? // set when someone taps "Start together" in the group lobby
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     GroupMember[]
  chatMessages ChatMessage[]
  posts       FeedPost[]
  runSessions RunSession[]
  challenges  Challenge[]
}

model GroupMember {
  id          String   @id @default(cuid())
  groupId     String
  userId      String
  role        String   @default("member") // member, admin, owner
  joinedAt    DateTime @default(now())
  checkedInAt DateTime? // lobby presence; fresh within 2h counts as "here"

  group       RunGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model FeedPost {
  id          String   @id @default(cuid())
  authorId    String
  groupId     String?
  content     String
  imageUrl    String?
  postType    String   @default("moment") // moment, milestone, question, challenge
  runSessionId String? // set when the post shares a tracked run (route card)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group       RunGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  runSession  RunSession? @relation(fields: [runSessionId], references: [id], onDelete: SetNull)
  likedBy     PostLike[]
  commentThread PostComment[]
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   // recipient
  actorId   String?  // who triggered it (if anyone)
  type      String   // hotspot_join, run_invite, group_message, badge, rank_up, comment, like, run_complete
  title     String
  body      String?
  entityId  String?  // id of the related hotspot/group/post/etc.
  icon      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model RunSession {
  id            String    @id @default(cuid())
  clientRunId   String?   @unique // client-generated id; makes offline re-uploads idempotent
  userId        String
  hotspotId     String?   // set when the run is tied to a hotspot
  groupId       String?   // set when the run is tied to a group
  sportType     String    @default("running")
  distanceKm    Float     @default(0)
  durationSec   Int       @default(0)
  avgPaceSecPerKm Int     @default(0) // seconds per km; 0 when distance is 0
  calories      Int       @default(0)
  path          String?   // JSON-encoded array of {lat,lng} GPS samples
  splits        String?   // JSON-encoded array of per-km split seconds
  companions    Int       @default(0) // how many people ran together
  xpEarned      Int       @default(0)
  note          String?
  startedAt     DateTime  @default(now())
  endedAt       DateTime  @default(now())
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotspot       Hotspot?  @relation(fields: [hotspotId], references: [id], onDelete: SetNull)
  group         RunGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  posts         FeedPost[]

  @@index([userId])
}

// Unified message model for both DMs (recipientId set) and group chat (groupId set).
// Exactly one of recipientId or groupId must be non-null.
model ChatMessage {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String?  // set for DMs
  groupId     String?  // set for group chat
  content     String
  read        Boolean  @default(false) // only meaningful for DMs
  createdAt   DateTime @default(now())

  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User?     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  group       RunGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // "exactly one of recipientId / groupId" is enforced in the database by the
  // CHECK constraint ChatMessage_dm_xor_group (added in
  // 20260716120000_drop_stale_counters_add_indexes_xor). Prisma cannot express
  // CHECK constraints, so `prisma db push` will not recreate it — use
  // `migrate deploy`/`migrate dev`, or the guarantee is silently lost.
  @@index([senderId, recipientId])
  @@index([groupId])
}

model RunInvite {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  message     String?
  status      String   @default("pending") // pending, accepted, declined
  createdAt   DateTime @default(now())

  sender      User     @relation("SentInvites", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("ReceivedInvites", fields: [recipientId], references: [id], onDelete: Cascade)
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeType   String   // first_run, streak_3, streak_7, streak_30, social_butterfly, early_bird, night_owl, etc.
  title       String
  description String
  icon        String
  earnedAt    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeType])
}

model RunRating {
  id          String   @id @default(cuid())
  hotspotId   String
  userId      String
  rating      Int      // 1-5
  comment     String?
  createdAt   DateTime @default(now())

  hotspot     Hotspot  @relation(fields: [hotspotId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Prevents a user from submitting multiple ratings for the same hotspot.
  @@unique([hotspotId, userId])
}

// A running-buddy relationship, formed after running together. Directional rows
// (one per direction) so each user sees the other in their buddy list.
model Buddy {
  id        String   @id @default(cuid())
  userId    String
  buddyId   String
  createdAt DateTime @default(now())

  user      User     @relation("BuddyOwner", fields: [userId], references: [id], onDelete: Cascade)
  buddy     User     @relation("BuddyTarget", fields: [buddyId], references: [id], onDelete: Cascade)

  @@unique([userId, buddyId])
  @@index([userId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())

  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

// Community challenges — progress is computed on read from RunSessions in range,
// so there's no counter to keep in sync.
model Challenge {
  id          String   @id @default(cuid())
  title       String
  description String?
  metric      String   @default("distance") // distance, runs, buddies
  goal        Float    @default(0)
  scope       String   @default("global")   // global, group
  groupId     String?
  icon        String   @default("🏆")
  startsAt    DateTime @default(now())
  endsAt      DateTime
  createdBy   String?
  createdAt   DateTime @default(now())

  group        RunGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]
}

model ChallengeParticipant {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  joinedAt    DateTime @default(now())

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}
