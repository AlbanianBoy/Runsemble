generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Closed value sets ────────────────────────────────────────────────────────
// These were String columns carrying a "// a, b, c" comment. A comment is not a
// constraint: a bug or a hand-written PATCH could store any string at all, and
// nothing downstream would notice until a comparison silently stopped matching.
//
// src/lib/enums.ts mirrors these for request validation (so bad input is a 400,
// not a Prisma crash); src/lib/__tests__/enums.test.ts asserts the two stay in
// step, so adding a value here without updating the validator fails the tests.

// 'any' means "I'll run with anyone" — it is a real answer, offered in
// onboarding, and the map treats it as matching every pace filter. It was
// missing when this enum was introduced because the values were taken from the
// two rows then in the table rather than from the code that writes them.
enum PaceLevel {
  beginner
  intermediate
  advanced
  any
}

// NOTE: SchedulePreference was a single-value enum. It has been changed to a
// plain String column so users can select multiple time slots (stored as a
// comma-separated list, e.g. "morning,evening"). The enum is intentionally
// removed — do not re-add it. The migration must:
//   1. ALTER TABLE "User" ALTER COLUMN "schedulePreference" TYPE TEXT;
//   2. ALTER TABLE "User" ALTER COLUMN "schedulePreference" SET DEFAULT '';
//   3. DROP TYPE IF EXISTS "SchedulePreference";

enum SportType {
  running
  trail
  walking
}

enum PostType {
  moment
  milestone
  question
  challenge
}

enum GroupRole {
  member
  admin
  owner
}

// "here" = checked in at the lobby.
enum ParticipantStatus {
  joined
  here
  completed
  cancelled
}

enum InviteStatus {
  pending
  accepted
  declined
}

enum MessageRequestStatus {
  pending
  accepted
  declined
}

// What a report is about. Kept polymorphic (a plain subjectId, no FK) so one
// table covers people, posts and messages, and so a report survives the subject
// being deleted — the evidence snapshot is the record.
enum ReportSubjectType {
  user
  post
  message
}

enum ReportReason {
  harassment
  spam
  inappropriate
  unsafe // threats or unsafe behaviour at a meetup — the safety-critical one
  impersonation
  other
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  avatar            String?
  bio               String?
  city              String    @default("Antwerp")
  lat               Float?
  lng               Float?
  gender            String?   // optional, unlocks women-only runs
  verified          Boolean   @default(false)
  passwordHash      String?   // scrypt salt:hash; null for seed/demo profiles
  consentAt         DateTime? // when the user accepted data processing (GDPR)
  // WHICH policy text they accepted. A timestamp alone can't answer "what did
  // they agree to?" once the policy changes — null means the account predates
  // version tracking, which is the honest answer rather than a guessed backfill.
  consentVersion    String?
  // Self-declared at signup for the age gate. Stored (not just checked-and-
  // discarded) so the age check is evidenced, and so the threshold can change
  // without having re-prompted everyone. Null = account predates the gate.
  birthdate         DateTime?
  // Analytics is a separate purpose from the core service, so it needs its own
  // consent (Art. 7). Off by default; PostHog only initialises when this is true.
  analyticsConsent  Boolean   @default(false)
  emailVerified     Boolean   @default(false) // confirmed via 6-digit code
  emailVerifiedAt   DateTime?
  preferredSport    String    @default("running")
  paceLevel         PaceLevel @default(beginner)
  schedulePreference String   @default("")  // comma-separated: "morning", "morning,evening", etc.
  xp                Int       @default(0)
  streak            Int       @default(0)
  longestStreak     Int       @default(0)
  lastActiveDate    String?
  totalRuns         Int       @default(0)
  totalPeopleRunWith Int      @default(0)
  totalDistanceKm   Float     @default(0)
  totalDurationSec  Int       @default(0)
  isAvailable       Boolean   @default(false)
  availableFrom     DateTime? // planned availability ("free to run at 18:30")
  availableUntil    DateTime?
  privacyVisible    Boolean   @default(true)
  // Who may see that you're free to run: 'everyone' or 'women'. Separate from
  // privacyVisible, which hides you entirely — this hides only the schedule,
  // because "free at 18:30" repeated weekly is a routine, and a routine next to
  // a home cell is the thing worth protecting. See canSeeAvailability.
  availabilityAudience String @default("everyone")
  onboardingComplete Boolean  @default(false)
  // Moderation. A suspended account is refused a session (so it can't act) and
  // is hidden from discovery, DMs and hotspots. Null = in good standing. This is
  // what gives the report queue actual enforcement power rather than just a
  // status flag on the report.
  suspendedAt       DateTime?
  suspendedReason   String?
  // NOTE: fcmToken (a single column) was removed — see UserDevice. One column
  // meant a second device overwrote the first, which then silently received
  // nothing forever.
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  posts             FeedPost[]
  joinedHotspots    HotspotParticipant[]
  groupMemberships  GroupMember[]
  sentMessages      ChatMessage[] @relation("SentMessages")
  receivedMessages  ChatMessage[] @relation("ReceivedMessages")
  sentInvites       RunInvite[] @relation("SentInvites")
  messageRequestsSent     MessageRequest[] @relation("RequestsSent")
  messageRequestsReceived MessageRequest[] @relation("RequestsReceived")
  receivedInvites   RunInvite[] @relation("ReceivedInvites")
  earnedBadges      UserBadge[]
  runRatings        RunRating[]
  postLikes         PostLike[]
  postComments      PostComment[]
  runSessions       RunSession[]
  notifications     Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")
  buddies           Buddy[] @relation("BuddyOwner")
  buddyOf           Buddy[] @relation("BuddyTarget")
  blocksMade        Block[] @relation("Blocker")
  blockedBy         Block[] @relation("Blocked")
  reportsMade       Report[] @relation("Reporter")
  safeZones         SafeZone[]
  runShares         RunShare[]
  challengesJoined  ChallengeParticipant[]
  sessions          Session[]
  devices           UserDevice[]
  verificationTokens VerificationToken[]

  // The leaderboard sorts by any of these; each needs its own index or the board
  // degrades to a full scan + sort. xp is the default board, the rest are one tap away.
  @@index([xp])
  @@index([streak])
  @@index([totalRuns])
  @@index([totalDistanceKm])
  @@index([totalPeopleRunWith])
  // Discovery filters on a lat/lng bounding box (see /api/users). Without this
  // the range predicate is a sequential scan of every user on every map load.
  @@index([lat, lng])
}

// One row per device a user gets push on.
//
// This replaces a single fcmToken column on User. FCM issues a token per app
// install, so with one column a second device's registration overwrote the
// first — and the first then received nothing, forever, with no error anywhere.
// A phone plus a tablet, or a reinstall, was enough.
//
// The token is the identity: FCM can hand the same device a new one at any time
// (reinstall, restore, refresh), so it's the unique key and the row is upserted
// on it rather than on any device id we invent.
model UserDevice {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique // FCM registration token
  platform   String   @default("unknown") // android | ios | web
  enabled    Boolean  @default(true) // false once FCM says the token is dead
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Fan-out reads every enabled device for one user, on every notification.
  @@index([userId, enabled])
}

// Login sessions — token lives in an httpOnly cookie.
model Session {
  id        String   @id @default(cuid())
  // Only ever the SHA-256 of the cookie value. The raw token exists in the
  // user's cookie and nowhere else, so a leaked database dump is not a set of
  // working logins.
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Short-lived 6-digit codes for email verification and password reset.
// Stored as a SHA-256 hash; single-use (consumedAt) with an attempt cap.
model VerificationToken {
  id         String    @id @default(cuid())
  userId     String
  type       String    // "email_verify" | "password_reset"
  codeHash   String    // sha256 hex of the 6-digit code
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Hotspot {
  id          String    @id @default(cuid())
  name        String
  description String?
  location    String
  lat         Float
  lng         Float
  sportType   SportType @default(running)
  distanceKm  Float     @default(5.0)
  paceRange   String    @default("any")
  startTime   DateTime
  recurringIntervalMin Int @default(30)
  daysOfWeek  String?   // for weekly official runs, e.g. "1,3,5" (Mon/Wed/Fri); null = continuous
  audience    String    @default("all") // all, women, beginner
  lobbyStartedAt DateTime? // set when someone taps "Start together" in the lobby
  isActive    Boolean   @default(true)
  isOfficial  Boolean   @default(false) // curated city spot vs. user-created
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  participants HotspotParticipant[]
  ratings     RunRating[]
  runSessions RunSession[]
}

model HotspotParticipant {
  id          String   @id @default(cuid())
  hotspotId   String
  userId      String
  joinedAt    DateTime @default(now())
  status      ParticipantStatus @default(joined)
  checkedInAt DateTime?

  hotspot     Hotspot  @relation(fields: [hotspotId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hotspotId, userId])
}

model RunGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  isPublic    Boolean  @default(true)
  coverImage  String?
  city        String   @default("Antwerp")
  lobbyStartedAt DateTime? // set when someone taps "Start together" in the group lobby
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     GroupMember[]
  chatMessages ChatMessage[]
  posts       FeedPost[]
  runSessions RunSession[]
  challenges  Challenge[]

  // Backs group discovery exactly: public groups in one city, newest first.
  @@index([isPublic, city, createdAt])
}

model GroupMember {
  id          String   @id @default(cuid())
  groupId     String
  userId      String
  role        GroupRole @default(member)
  joinedAt    DateTime @default(now())
  checkedInAt DateTime? // lobby presence; fresh within 2h counts as "here"

  group       RunGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  // The unique above leads with groupId, so "which groups is this user in?" —
  // the filter behind both halves of discovery — couldn't use it and scanned.
  @@index([userId])
}

model FeedPost {
  id          String   @id @default(cuid())
  authorId    String
  groupId     String?
  content     String
  imageUrl    String?
  postType    PostType @default(moment)
  runSessionId String? // set when the post shares a tracked run (route card)
  // Client-generated id for the thing the user composed, so a retry after a
  // timeout collapses onto the same row instead of posting twice. Same
  // pattern as RunSession.clientRunId. Nullable: rows written before this
  // existed, and any server-side write, simply have none — Postgres does not
  // treat NULLs as colliding, so the unique below still permits them.
  clientId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group       RunGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  runSession  RunSession? @relation(fields: [runSessionId], references: [id], onDelete: SetNull)
  likedBy     PostLike[]
  commentThread PostComment[]

  // The feed is the hottest read in the app and paginates by (createdAt, id)
  // desc; without this it was a full-table scan + top-N sort on every load.
  @@index([createdAt, id])
  @@index([authorId])
  @@index([groupId])
  @@unique([authorId, clientId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  // Client-generated id for the thing the user composed, so a retry after a
  // timeout collapses onto the same row instead of posting twice. Same
  // pattern as RunSession.clientRunId. Nullable: rows written before this
  // existed, and any server-side write, simply have none — Postgres does not
  // treat NULLs as colliding, so the unique below still permits them.
  clientId  String?
  createdAt DateTime @default(now())

  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@unique([authorId, clientId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   // recipient
  actorId   String?  // who triggered it (if anyone)
  type      String   // hotspot_join, run_invite, group_message, badge, rank_up, comment, like, run_complete
  title     String
  body      String?
  entityId  String?  // id of the related hotspot/group/post/etc.
  icon      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  // Two reads, two shapes. The unread badge counts on (userId, read); the inbox
  // lists this user's rows newest-first, which the read-flag index can't order,
  // so it was fetching the user's whole history and sorting it every open.
  @@index([userId, read])
  @@index([userId, createdAt])
}

model RunSession {
  id            String    @id @default(cuid())
  // Client-generated id; makes offline re-uploads idempotent. Scoped to the
  // user, not global — two people's devices picking the same id is not a
  // duplicate run, and globally unique would silently reject the second one.
  clientRunId   String?
  userId        String
  hotspotId     String?   // set when the run is tied to a hotspot
  groupId       String?   // set when the run is tied to a group
  sportType     SportType @default(running)
  distanceKm    Float     @default(0)
  durationSec   Int       @default(0)
  avgPaceSecPerKm Int     @default(0) // seconds per km; 0 when distance is 0
  calories      Int       @default(0)
  path          String?   // JSON-encoded array of {lat,lng} GPS samples
  splits        String?   // JSON-encoded array of per-km split seconds
  companions    Int       @default(0) // how many people ran together
  xpEarned      Int       @default(0)
  note          String?
  startedAt     DateTime  @default(now())
  endedAt       DateTime  @default(now())
  createdAt     DateTime  @default(now())
  // When the exact GPS trace was replaced with a blinded, thinned version by the
  // retention job. Null = still the raw trace (within the 90-day window). The
  // marker is what lets the daily cron run safely: a row is coarsened once and
  // then skipped forever, never re-thinned down to nothing.
  pathCoarsenedAt DateTime?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotspot       Hotspot?  @relation(fields: [hotspotId], references: [id], onDelete: SetNull)
  group         RunGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  posts         FeedPost[]

  @@unique([userId, clientRunId])
  @@index([userId])
  // The retention cron scans for old, not-yet-coarsened runs; this keeps that
  // from being a full-table scan as the runs pile up.
  @@index([pathCoarsenedAt, endedAt])
}

// ─── Live run sharing ─────────────────────────────────────────────────────────
// A runner hands one person a link and that person watches the run happen. No
// account, no app, no follow request: the recipient opens /watch/<token> in
// whatever browser they already have and sees a moving dot until the run ends.
// It is the "text someone before you head out in the dark" habit, made real.
//
// The URL IS the credential — there is nothing else between a stranger and a
// live position — so `token` is 32 random bytes, not a cuid. cuids are ordered
// and partly derived from time and machine, which is fine for a row id nobody
// can reach without a session and not fine for the only lock on this door.
//
// The stored position is EXACT, and that is deliberate. The safe-zone blinding
// and 200m display fuzz that protect every other coordinate in this product
// (src/lib/safe-zones.ts, src/lib/location-privacy.ts) are NOT applied here: a
// contact sent to a blurred 200m cell cannot find anyone, and "somewhere around
// there" is worthless to the person trying to reach a runner who has stopped
// moving. This is the one place where precision beats privacy. It is bounded
// rather than simply given away — opt-in per run, one link at a time, revocable
// in a tap, dead when the run ends, and hard-expired at four hours whatever
// happens. The daily cron (src/app/api/cron/coarsen-runs) then deletes the row,
// so a dead link does not leave a location history behind it.
//
// sosAt flags the share so a watcher with the page open sees an alarm, and
// nothing more: it phones nobody. The runner-facing copy says exactly that and
// points at 112, because a safety feature that implies help is coming when it
// is not is worse than no feature.
//
// "One active share per runner" is enforced in the API rather than by a unique
// index: active means (not revoked, not ended, not yet expired), a predicate
// over three nullable timestamps and the current time, which no index can hold.
// Asking for a second link while one is live returns the first one.
model RunShare {
  id          String    @id @default(cuid())
  token       String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  // Set at creation to now + 4h and never moved. A share can die earlier two
  // ways — endedAt when the run is saved, revokedAt when the runner pulls it —
  // but it can never live longer than this, which is what covers the case the
  // other two miss: the app is killed mid-run and nothing writes an ending.
  expiresAt   DateTime
  endedAt     DateTime?
  revokedAt   DateTime?
  // First alarm only; the beacon never overwrites it. "Raised at 19:04" is the
  // fact a watcher needs, and re-arming would keep resetting it to now.
  sosAt       DateTime?
  // The live fix, overwritten by each beacon. Deliberately unblinded — see above.
  lat         Float?
  lng         Float?
  accuracyM   Float?
  // Freshness, not history. The watcher shows the run as stale rather than
  // pretending a three-minute-old dot is where the runner is standing.
  lastPingAt  DateTime?
  distanceKm  Float     @default(0)
  durationSec Int       @default(0)

  // The runner's own share, newest first — the "do I already have one live?"
  // lookup on every tracker load.
  @@index([userId, createdAt])
  // The retention sweep scans by expiry; without this it is a full-table scan.
  @@index([expiresAt])
}

// Unified message model for both DMs (recipientId set) and group chat (groupId set).
// Exactly one of recipientId or groupId must be non-null.
model ChatMessage {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String?  // set for DMs
  groupId     String?  // set for group chat
  content     String
  read        Boolean  @default(false) // only meaningful for DMs
  // Client-generated id for the thing the user composed, so a retry after a
  // timeout collapses onto the same row instead of posting twice. Same
  // pattern as RunSession.clientRunId. Nullable: rows written before this
  // existed, and any server-side write, simply have none — Postgres does not
  // treat NULLs as colliding, so the unique below still permits them.
  clientId    String?
  createdAt   DateTime @default(now())

  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User?     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  group       RunGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId])
  @@index([groupId])
  // The DM inbox and unread badge query by recipient; this backs those without a
  // scan as message volume grows.
  @@index([recipientId, read])
  @@unique([senderId, clientId])
}

model RunInvite {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  message     String?
  status      InviteStatus @default(pending)
  createdAt   DateTime @default(now())

  sender      User     @relation("SentInvites", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("ReceivedInvites", fields: [recipientId], references: [id], onDelete: Cascade)
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeType   String   // first_run, streak_3, streak_7, streak_30, social_butterfly, early_bird, night_owl, etc.
  title       String
  description String
  icon        String
  earnedAt    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeType])
}

model RunRating {
  id          String   @id @default(cuid())
  hotspotId   String
  userId      String
  rating      Int      // 1-5
  comment     String?
  createdAt   DateTime @default(now())

  hotspot     Hotspot  @relation(fields: [hotspotId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hotspotId, userId])
}

// ─── Message requests ─────────────────────────────────────────────────────────
// A stranger's first message is a request, not a delivery.
//
// Anyone could DM anyone, and every message fired a push. On an app whose whole
// premise is meeting people you don't know yet, that makes the inbox — and the
// lock screen — reachable by any account that can find you on the map. Blocking
// works, but only after the message has already arrived and buzzed.
//
// So a first message from someone you have no connection with lands here
// instead: stored, visible when you go looking, and silent. Accepting opens the
// conversation and lets pushes through. Declining closes it without telling
// them, which is the point — a decline that notifies is a decline people are
// afraid to use.
//
// Directional: A requesting B is not B requesting A. If B ever messages A, that
// is acceptance by conduct and the request is settled without a tap.
model MessageRequest {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  status      MessageRequestStatus @default(pending)
  createdAt   DateTime @default(now())
  respondedAt DateTime?

  sender      User     @relation("RequestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("RequestsReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([senderId, recipientId])
  // The recipient's "who is waiting on me" list, newest first.
  @@index([recipientId, status, createdAt])
}

model Buddy {
  id        String   @id @default(cuid())
  userId    String
  buddyId   String
  createdAt DateTime @default(now())

  user      User     @relation("BuddyOwner", fields: [userId], references: [id], onDelete: Cascade)
  buddy     User     @relation("BuddyTarget", fields: [buddyId], references: [id], onDelete: Cascade)

  @@unique([userId, buddyId])
  @@index([userId])
}

// An area where this user's location is never shared — home, work, the gym.
// The 200m display fuzz makes a pin approximate, but an approximate pin at the
// same spot every evening still says where someone sleeps. Inside a zone the
// map shows nothing at all (Strava shipped the same idea after real harm).
//
// The zone centre IS the sensitive place, so zones are visible only to their
// owner: they must never pass through toPublicUser, and the projection deletes
// the key as defense in depth.
model SafeZone {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("Home")
  lat       Float
  lng       Float
  radiusM   Int      @default(500)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())

  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  // Every block-aware read filters "is X blocked by / blocking me" in both
  // directions; the blockerId side is covered by the unique index, this covers
  // the reverse lookup that otherwise sequential-scans.
  @@index([blockedId])
}

// A report an operator needs to see and act on. This app arranges for strangers
// to meet in person, so a way to flag someone — and a queue behind it — is a
// duty-of-care requirement, not a feature. Block only hides someone from the
// reporter; it tells nobody.
//
// subjectId is a plain string, not a foreign key: the subject may be a user, a
// post, or a message, and the report must outlive the subject being deleted so
// the evidence survives. `evidence` is a JSON snapshot of the reported content at
// report time, captured server-side, so a deleted post can still be reviewed.
model Report {
  id           String            @id @default(cuid())
  // Nullable + SetNull, NOT Cascade: when a reporter deletes their account the
  // report and its evidence snapshot must survive — otherwise anyone could erase
  // the abuse case filed against them by deleting the account that filed it.
  reporterId   String?
  subjectType  ReportSubjectType
  subjectId    String
  reason       ReportReason
  details      String? // free text from the reporter
  evidence     String? // JSON snapshot of the reported content when filed
  status       ReportStatus      @default(open)
  resolvedById String? // admin who actioned it (plain id, no FK)
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())

  reporter     User?             @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)

  // One report per person per subject: re-filing updates rather than piling up,
  // so one reporter can't flood the queue. Many DIFFERENT reporters on the same
  // subject is the signal that matters, and that still accumulates.
  @@unique([reporterId, subjectType, subjectId])
  // The queue: open reports, newest first.
  @@index([status, createdAt])
  // All reports about one subject — how many people flagged this person.
  @@index([subjectType, subjectId])
}

model Challenge {
  id          String   @id @default(cuid())
  title       String
  description String?
  metric      String   @default("distance") // distance, runs, buddies
  goal        Float    @default(0)
  scope       String   @default("global")   // global, group
  groupId     String?
  icon        String   @default("🏆")
  startsAt    DateTime @default(now())
  endsAt      DateTime
  createdBy   String?
  createdAt   DateTime @default(now())

  group        RunGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]
}

model ChallengeParticipant {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  joinedAt    DateTime @default(now())

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}
