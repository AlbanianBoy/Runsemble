generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Closed value sets ────────────────────────────────────────────────────────
// These were String columns carrying a "// a, b, c" comment. A comment is not a
// constraint: a bug or a hand-written PATCH could store any string at all, and
// nothing downstream would notice until a comparison silently stopped matching.
//
// src/lib/enums.ts mirrors these for request validation (so bad input is a 400,
// not a Prisma crash); src/lib/__tests__/enums.test.ts asserts the two stay in
// step, so adding a value here without updating the validator fails the tests.

// 'any' means "I'll run with anyone" — it is a real answer, offered in
// onboarding, and the map treats it as matching every pace filter. It was
// missing when this enum was introduced because the values were taken from the
// two rows then in the table rather than from the code that writes them.
enum PaceLevel {
  beginner
  intermediate
  advanced
  any
}

// NOTE: SchedulePreference was a single-value enum. It has been changed to a
// plain String column so users can select multiple time slots (stored as a
// comma-separated list, e.g. "morning,evening"). The enum is intentionally
// removed — do not re-add it. The migration must:
//   1. ALTER TABLE "User" ALTER COLUMN "schedulePreference" TYPE TEXT;
//   2. ALTER TABLE "User" ALTER COLUMN "schedulePreference" SET DEFAULT '';
//   3. DROP TYPE IF EXISTS "SchedulePreference";

enum SportType {
  running
  trail
  walking
}

enum PostType {
  moment
  milestone
  question
  challenge
}

enum GroupRole {
  member
  admin
  owner
}

// "here" = checked in at the lobby.
enum ParticipantStatus {
  joined
  here
  completed
  cancelled
}

enum InviteStatus {
  pending
  accepted
  declined
}

enum MessageRequestStatus {
  pending
  accepted
  declined
}

// What a report is about. Kept polymorphic (a plain subjectId, no FK) so one
// table covers people, posts and messages, and so a report survives the subject
// being deleted — the evidence snapshot is the record.
enum ReportSubjectType {
  user
  post
  message
}

enum ReportReason {
  harassment
  spam
  inappropriate
  unsafe // threats or unsafe behaviour at a meetup — the safety-critical one
  impersonation
  other
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  avatar            String?
  bio               String?
  city              String    @default("Antwerp")
  lat               Float?
  lng               Float?
  gender            String?   // optional, unlocks women-only runs
  verified          Boolean   @default(false)
  passwordHash      String?   // scrypt salt:hash; null for seed/demo profiles
  consentAt         DateTime? // when the user accepted data processing (GDPR)
  // WHICH policy text they accepted. A timestamp alone can't answer "what did
  // they agree to?" once the policy changes — null means the account predates
  // version tracking, which is the honest answer rather than a guessed backfill.
  consentVersion    String?
  // Self-declared at signup for the age gate. Stored (not just checked-and-
  // discarded) so the age check is evidenced, and so the threshold can change
  // without having re-prompted everyone. Null = account predates the gate.
  birthdate         DateTime?
  // Analytics is a separate purpose from the core service, so it needs its own
  // consent (Art. 7). Off by default; PostHog only initialises when this is true.
  analyticsConsent  Boolean   @default(false)
  emailVerified     Boolean   @default(false) // confirmed via 6-digit code
  emailVerifiedAt   DateTime?
  preferredSport    String    @default("running")
  paceLevel         PaceLevel @default(beginner)
  schedulePreference String   @default("")  // comma-separated: "morning", "morning,evening", etc.
  xp                Int       @default(0)
  streak            Int       @default(0)
  longestStreak     Int       @default(0)
  lastActiveDate    String?
  totalRuns         Int       @default(0)
  totalPeopleRunWith Int      @default(0)
  totalDistanceKm   Float     @default(0)
  totalDurationSec  Int       @default(0)
  isAvailable       Boolean   @default(false)
  availableFrom     DateTime? // planned availability ("free to run at 18:30")
  availableUntil    DateTime?
  privacyVisible    Boolean   @default(true)
  // Who may see that you're free to run: 'everyone' or 'women'. Separate from
  // privacyVisible, which hides you entirely — this hides only the schedule,
  // because "free at 18:30" repeated weekly is a routine, and a routine next to
  // a home cell is the thing worth protecting. See canSeeAvailability.
  availabilityAudience String @default("everyone")
  onboardingComplete Boolean  @default(false)
  // Moderation. A suspended account is refused a session (so it can't act) and
  // is hidden from discovery, DMs and hotspots. Null = in good standing. This is
  // what gives the report queue actual enforcement power rather than just a
  // status flag on the report.
  suspendedAt       DateTime?
  suspendedReason   String?
  // NOTE: fcmToken (a single column) was removed — see UserDevice. One column
  // meant a second device overwrote the first, which then silently received
  // nothing forever.
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  posts             FeedPost[]
  joinedHotspots    HotspotParticipant[]
  groupMemberships  GroupMember[]
  sentMessages      ChatMessage[] @relation("SentMessages")
  receivedMessages  ChatMessage[] @relation("ReceivedMessages")
  sentInvites       RunInvite[] @relation("SentInvites")
  messageRequestsSent     MessageRequest[] @relation("RequestsSent")
  messageRequestsReceived MessageRequest[] @relation("RequestsReceived")
  receivedInvites   RunInvite[] @relation("ReceivedInvites")
  earnedBadges      UserBadge[]
  runRatings        RunRating[]
  postLikes         PostLike[]
  postComments      PostComment[]
  runSessions       RunSession[]
  notifications     Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")
  buddies           Buddy[] @relation("BuddyOwner")
  buddyOf           Buddy[] @relation("BuddyTarget")
  blocksMade        Block[] @relation("Blocker")
  blockedBy         Block[] @relation("Blocked")
  reportsMade       Report[] @relation("Reporter")
  safeZones         SafeZone[]
  runShares         RunShare[]
  challengesJoined  ChallengeParticipant[]
  sessions          Session[]
  devices           UserDevice[]
  verificationTokens VerificationToken[]

  @@index([xp])
  @@index([streak])
  @@index([totalRuns])
  @@index([totalDistanceKm])
  @@index([totalPeopleRunWith])
  @@index([lat, lng])
}

model UserDevice {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String   @default("unknown")
  enabled    Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String    @id @default(cuid())
  userId     String
  type       String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Hotspot {
  id          String    @id @default(cuid())
  name        String
  description String?
  location    String
  lat         Float
  lng         Float
  sportType   SportType @default(running)
  distanceKm  Float     @default(5.0)
  paceRange   String    @default("any")
  startTime   DateTime
  recurringIntervalMin Int @default(30)
  daysOfWeek  String?
  audience    String    @default("all")
  lobbyStartedAt DateTime?
  isActive    Boolean   @default(true)
  isOfficial  Boolean   @default(false)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  participants HotspotParticipant[]
  ratings     RunRating[]
  runSessions RunSession[]
}

model HotspotParticipant {
  id          String   @id @default(cuid())
  hotspotId   String
  userId      String
  joinedAt    DateTime @default(now())
  status      ParticipantStatus @default(joined)
  checkedInAt DateTime?

  hotspot     Hotspot  @relation(fields: [hotspotId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hotspotId, userId])
}

model RunGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  isPublic    Boolean  @default(true)
  coverImage  String?
  city        String   @default("Antwerp")
  lobbyStartedAt DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     GroupMember[]
  chatMessages ChatMessage[]
  posts       FeedPost[]
  runSessions RunSession[]
  challenges  Challenge[]

  @@index([isPublic, city, createdAt])
}

model GroupMember {
  id          String   @id @default(cuid())
  groupId     String
  userId      String
  role        GroupRole @default(member)
  joinedAt    DateTime @default(now())
  checkedInAt DateTime?

  group       RunGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model FeedPost {
  id          String   @id @default(cuid())
  authorId    String
  groupId     String?
  content     String
  imageUrl    String?
  postType    PostType @default(moment)
  runSessionId String?
  clientId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group       RunGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  runSession  RunSession? @relation(fields: [runSessionId], references: [id], onDelete: SetNull)
  likedBy     PostLike[]
  commentThread PostComment[]

  @@index([createdAt, id])
  @@index([authorId])
  @@index([groupId])
  @@unique([authorId, clientId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  clientId  String?
  createdAt DateTime @default(now())

  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@unique([authorId, clientId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String?
  type      String
  title     String
  body      String?
  entityId  String?
  icon      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ─── Durable notification outbox ─────────────────────────────────────────────
// The run transaction commits, then notifications fire. If the serverless
// function crashes between those two moments the run is saved but the people
// tagged in it are never told — permanently, because nothing retries a fan-out
// that never got to start.
//
// The fix: enqueue the notification intent INSIDE the same transaction that
// commits the run. The run and the promise-to-notify are now one atomic fact.
// A drain cron (src/app/api/cron/drain-outbox) retries any row that wasn't
// delivered by the inline fast path.
//
// Why Postgres and not Upstash: the enqueue must be transactional with the run
// write. Redis is not. A Postgres table is a durable queue and the least-
// moving-parts option here.
model NotificationOutbox {
  id             String    @id @default(cuid())
  // JSON-serialised NotifySpec — userId, actorId, type, title, body, entityId, icon.
  // Stored as text rather than Json so the column is readable without a cast and
  // survives any future Prisma Json quirks on Neon.
  payload        String
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?
  attempts       Int       @default(0)
  // When the drain worker should next try this row. Null = try immediately.
  // Set to an exponential backoff on failure; left null on first insert so
  // the inline fast-path and the cron both pick it up without a special case.
  nextAttemptAt  DateTime?

  // The drain query: undelivered rows whose retry window has opened.
  @@index([deliveredAt, nextAttemptAt])
}

model RunSession {
  id            String    @id @default(cuid())
  clientRunId   String?
  userId        String
  hotspotId     String?
  groupId       String?
  sportType     SportType @default(running)
  distanceKm    Float     @default(0)
  durationSec   Int       @default(0)
  avgPaceSecPerKm Int     @default(0)
  calories      Int       @default(0)
  path          String?
  splits        String?
  companions    Int       @default(0)
  xpEarned      Int       @default(0)
  note          String?
  startedAt     DateTime  @default(now())
  endedAt       DateTime  @default(now())
  createdAt     DateTime  @default(now())
  pathCoarsenedAt DateTime?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotspot       Hotspot?  @relation(fields: [hotspotId], references: [id], onDelete: SetNull)
  group         RunGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  posts         FeedPost[]

  @@unique([userId, clientRunId])
  @@index([userId])
  @@index([pathCoarsenedAt, endedAt])
}

model RunShare {
  id          String    @id @default(cuid())
  token       String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  endedAt     DateTime?
  revokedAt   DateTime?
  sosAt       DateTime?
  lat         Float?
  lng         Float?
  accuracyM   Float?
  lastPingAt  DateTime?
  distanceKm  Float     @default(0)
  durationSec Int       @default(0)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model ChatMessage {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String?
  groupId     String?
  content     String
  read        Boolean  @default(false)
  clientId    String?
  createdAt   DateTime @default(now())

  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User?     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  group       RunGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId])
  @@index([groupId])
  @@index([recipientId, read])
  @@unique([senderId, clientId])
}

model RunInvite {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  message     String?
  status      InviteStatus @default(pending)
  createdAt   DateTime @default(now())

  sender      User     @relation("SentInvites", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("ReceivedInvites", fields: [recipientId], references: [id], onDelete: Cascade)
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeType   String
  title       String
  description String
  icon        String
  earnedAt    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeType])
}

model RunRating {
  id          String   @id @default(cuid())
  hotspotId   String
  userId      String
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  hotspot     Hotspot  @relation(fields: [hotspotId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hotspotId, userId])
}

model MessageRequest {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  status      MessageRequestStatus @default(pending)
  createdAt   DateTime @default(now())
  respondedAt DateTime?

  sender      User     @relation("RequestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("RequestsReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([senderId, recipientId])
  @@index([recipientId, status, createdAt])
}

model Buddy {
  id        String   @id @default(cuid())
  userId    String
  buddyId   String
  createdAt DateTime @default(now())

  user      User     @relation("BuddyOwner", fields: [userId], references: [id], onDelete: Cascade)
  buddy     User     @relation("BuddyTarget", fields: [buddyId], references: [id], onDelete: Cascade)

  @@unique([userId, buddyId])
  @@index([userId])
}

model SafeZone {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("Home")
  lat       Float
  lng       Float
  radiusM   Int      @default(500)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())

  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id           String            @id @default(cuid())
  reporterId   String?
  subjectType  ReportSubjectType
  subjectId    String
  reason       ReportReason
  details      String?
  evidence     String?
  status       ReportStatus      @default(open)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())

  reporter     User?             @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)

  @@unique([reporterId, subjectType, subjectId])
  @@index([status, createdAt])
  @@index([subjectType, subjectId])
}

model Challenge {
  id          String   @id @default(cuid())
  title       String
  description String?
  metric      String   @default("distance")
  goal        Float    @default(0)
  scope       String   @default("global")
  groupId     String?
  icon        String   @default("🏆")
  startsAt    DateTime @default(now())
  endsAt      DateTime
  createdBy   String?
  createdAt   DateTime @default(now())

  group        RunGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]
}

model ChallengeParticipant {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  joinedAt    DateTime @default(now())

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}
